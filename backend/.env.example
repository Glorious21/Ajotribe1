# Breez SDK Liquid — server wallet (holds circle pool sats between contributions and payout)
BREEZ_API_KEY=
# Generate mnemonic: node -e "const {generateMnemonic}=require('bip39');console.log(generateMnemonic())"
BREEZ_MNEMONIC=
# Absolute path where Breez stores local wallet state (must be writable by the process)
BREEZ_WORKING_DIR=./breez-data

# Bitnob
BITNOB_API_KEY=
BITNOB_WEBHOOK_SECRET=
BITNOB_BASE_URL=https://api.bitnob.co/api/v1

# Mavapay
MAVAPAY_API_KEY=
MAVAPAY_BASE_URL=https://api.mavapay.co

# Cashwyre
CASHWYRE_API_KEY=
CASHWYRE_BASE_URL=https://business.cashwyre.com/api

# Paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# Infobip (OTP SMS)
# INFOBIP_BASE_URL: your personal base URL from the Infobip portal (e.g. xxxxx.api.infobip.com)
INFOBIP_API_KEY=
INFOBIP_BASE_URL=
INFOBIP_SENDER=Ajotribe

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/myajo
REDIS_URL=redis://localhost:6379

# App
JWT_SECRET=change-me-to-a-random-32-char-string
ENCRYPTION_KEY=change-me-to-a-random-32-char-hex
APP_ENV=development
PORT=3000

# Nostr
NOSTR_RELAYS=wss://relay.damus.io,wss://nos.lol,wss://relay.primal.net
